{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@aws-amplify/backend": ["./node_modules/@aws-amplify/backend"]
    }
  },
  "include": ["./**/*.ts"]
}
